# ============================================================
# mcx-comm — Environment Configuration
# Copy this to .env and fill in your values.
# ============================================================

# Zerodha Kite API credentials (same account as nifty-strike-engine)
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here

# DO NOT set KITE_ACCESS_TOKEN here — it is read automatically from
# nifty-strike-engine's .env via NSE_ENV_PATH below.
# If you prefer to set it manually here, it will take precedence.
# KITE_ACCESS_TOKEN=your_access_token_here

# Path to nifty-strike-engine project (for shared token)
NSE_ENV_PATH=D:/Workspace/nifty-strike-engine/.env

# Discord webhook for all trade signals
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_TOKEN

# Set to true only when ready for live trading on MCX
LIVE_ORDER_PLACEMENT=false
