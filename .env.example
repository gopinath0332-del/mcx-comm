# ============================================================
# mcx-comm — Environment Configuration
# Copy this to .env and fill in your values.
# ============================================================

# Path to nifty-strike-engine project .env
# All Kite credentials (KITE_API_KEY, KITE_API_SECRET, KITE_ACCESS_TOKEN)
# will be automatically loaded from this file.
NSE_ENV_PATH=D:/Workspace/nifty-strike-engine/.env

# Discord webhook for all trade signals & briefings
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_TOKEN

# Set to true only when ready for live trading on MCX (default: false for paper trading)
LIVE_ORDER_PLACEMENT=false

# ------------------------------------------------------------
# Optional overrides (only if you want different credentials from NSE):
# KITE_API_KEY=
# KITE_ACCESS_TOKEN=
